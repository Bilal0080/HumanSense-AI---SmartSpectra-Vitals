{
  "name": "humansense-ai",
  "productName": "HumanSense AI",
  "version": "1.0.0",
  "description": "Real-time contactless physiological vitals measurement desktop application powered by Presage SmartSpectra SDK.",
  "main": "src/main.cjs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "electron:dev": "vite build && electron src/main.cjs",
    "electron:dist": "vite build && electron-builder --win",
    "preview": "vite preview",
    "clean": "rm -rf dist release server.js",
    "lint": "tsc --noEmit",
    "test": "node test-suite.cjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@smartspectra/node-sdk": "^3.4.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "@types/express": "^4.17.21"
  },
  "build": {
    "appId": "com.humansense.ai",
    "productName": "HumanSense AI",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": ["nsis", "portable"],
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-win32-x64/",
          "to": "smartspectra/"
        }
      ]
    },
    "linux": {
      "target": ["AppImage"],
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-linux-x64/",
          "to": "smartspectra/"
        }
      ]
    },
    "mac": {
      "target": ["dmg"],
      "extraResources": [
        {
          "from": "node_modules/@smartspectra/node-sdk-darwin-arm64/",
          "to": "smartspectra/"
        }
      ]
    }
  }
}
